* ====================================================================
* 08_export_presentation.do | MESR conference presentation exports
* Author: Lonjezo Erick Folias
* Purpose: export tabular LaTeX fragments and PDF figures from COMPLETED
*          main-run table datasets. NO estimation or bootstrap is run.
* Run AFTER 07_MESR_main.do has finished successfully.
* Requires global result; presentation defaults to $result/latex.
* Existing estimation, data and effect definitions are unchanged.
* ====================================================================


version 16
set more off

* Run the master first to define $result. Alternatively define it manually.
* Set $presentation to a local Overleaf project to export there directly.
if "$result"=="" {
    di as error "Define global result, or run 00_master-dofile.do first."
    exit 198
}
if "$presentation"=="" global presentation "$result/latex"

confirm file "$result/latex/export_complete.txt"
tempname ck
file open `ck' using "$result/latex/export_complete.txt", read text
file read `ck' status
file close `ck'
local nt=real("`status'")
if missing(`nt') | `nt'<1 {
    di as error "Main export incomplete: finish the main do-file first."
    exit 459
}
* Redefine only the escaping helper to accept legitimately blank cells.
capture program drop mesr_tex_escape
program define mesr_tex_escape, rclass
    syntax [, TEXT(string)]
    local t `"`text'"'
    local t=subinstr(`"`t'"',char(92),char(1),.)
    foreach ch in 123 125 38 37 36 35 95 {
        local t=subinstr(`"`t'"',char(`ch'),char(92)+char(`ch'),.)
    }
    local t=subinstr(`"`t'"',char(1),"\textbackslash{}",.)
    local t=subinstr(`"`t'"',"−","-",.)
    local t=subinstr(`"`t'"',"–","--",.)
    local t=subinstr(`"`t'"',"—","--",.)
    local t=subinstr(`"`t'"',"≥","$\geq$",.)
    local t=subinstr(`"`t'"',"≤","$\leq$",.)
    local t=subinstr(`"`t'"',"χ²","$\chi^2$",.)
    local t=subinstr(`"`t'"',"λ","$\lambda$",.)
    local t=subinstr(`"`t'"',"ρ","$\rho$",.)
    local t=subinstr(`"`t'"',"σ","$\sigma$",.)
    local t=subinstr(`"`t'"',"²","$^2$",.)
    local t=subinstr(`"`t'"',"°","$^\circ$",.)
    local t=subinstr(`"`t'"',"±","$\pm$",.)
    local t=subinstr(`"`t'"',char(10)," ",.)
    return local tex `"`t'"'
end
capture mkdir "$presentation"
capture mkdir "$presentation/tables"
capture mkdir "$presentation/figures"
tempname manifest
file open `manifest' using "$presentation/tables/export_status.txt", write text replace
file write `manifest' "INCOMPLETE" _n
file close `manifest'
foreach fig in Fig2_outcomes_10_15.png Fig3_overlap_10_15.png {
    confirm file "$result/`fig'"
}
local required ta2 t1 t3 t4 t5 t6 mproductivitywinsr eproductivitywinsr mHDDS eHDDS mFCS eFCS
local exportnames ""
preserve
* Resolve all inputs by their saved logical name, NOT serial table number.
forvalues i=1/`nt' {
    local sid=string(`i',"%02.0f")
    use "$result/latex/data/table_`sid'.dta", clear
    local nm : char _dta[mesr_name]
    if "`nm'"=="" {
        restore
        di as error "Missing logical table name in table_`sid'.dta."
        exit 459
    }
    local input_`nm' "$result/latex/data/table_`sid'.dta"
    local exportnames `exportnames' `nm' 
}
foreach nm of local required {
    if `"`input_`nm''"'=="" {
        restore
        di as error "Required table missing: `nm'. Finish the full main run."
        exit 459
    }
}
* No LaTeX floats/captions/preambles here: the slide controls presentation.
foreach nm of local exportnames {
    if "`nm'"=="ta2" continue
    use `"`input_`nm''"', clear
    unab vl : _all
    local nc : word count `vl'
    local first : word 1 of `vl'
    local hr : char _dta[mesr_headrows]
    local spans : char _dta[mesr_spans]
    local note : char _dta[mesr_note]
    if substr("`nm'",1,1)=="e" local note "ATT: regime participants. ATU: households in neither. ATE: all households. SEs in parentheses. BH1/BH2: base heterogeneity. TH = ATT - ATU. ***, **, *: 1%, 5%, 10%."
    local nr=_N
    local ise=substr("`nm'",1,1)=="e"
    local spec ""
    forvalues c=1/`nc' {
        local w=cond(`c'==1,.26,.64/(`nc'-1))
        if `nc'==9 local w=cond(`c'==1,.20,cond(mod(`c',2)==0,.14,.035))
        if "`nm'"=="t5" local w=cond(`c'==1,.225,cond(mod(`c',2)==0,.16,.065))
        if `ise' {
            local ww .135 .21 .155 .155 .215 .075
            local w : word `c' of `ww'
        }
        if "`nm'"=="t6" local w=cond(`c'==1,.68,.14)
        local wt=string(`w',"%6.4f")
        local spec `"`spec'>{\raggedright\arraybackslash}p{`wt'\linewidth}"'
    }
    tempname fh
    file open `fh' using "$presentation/tables/`nm'.tex", write text replace
    file write `fh' "% Generated by 08_export_presentation.do from completed Stata results." _n
    file write `fh' "\begin{tabular}{@{}`spec'@{}}\toprule" _n
    local rr=1
    while `rr'<=`nr' {
        local paired=0
        if `rr'>`hr' & `rr'<`nr' & `first'[`rr'+1]=="" {
            foreach v of local vl {
                if "`v'"!="`first'" & substr(strtrim(`v'[`rr'+1]),1,1)=="(" local paired=1
            }
        }
        if `ise' & inlist(`rr',6,10) file write `fh' "\addlinespace[11pt]" _n
        local c=1
        local line ""
        while `c'<=`nc' {
            local v : word `c' of `vl'
            local value=`v'[`rr']
            if `paired' & `v'[`rr'+1]!="" local value=`"`value' "'+`v'[`rr'+1]
            quietly mesr_tex_escape, text(`"`value'"')
            local value `"`r(tex)'"'
            local width=1
            foreach sp of local spans {
                tokenize "`sp'", parse(":")
                if `rr'==`1' & `c'==`3' local width=`5'
            }
            if `ise' & inlist(`rr',5,9,13) & `"`value'"'!="" local value `"\textbf{`value'}"'
            if `rr'<=`hr' local value `"\textbf{`value'}"'
            if `width'>1 local value `"\multicolumn{`width'}{c}{`value'}"'
            if `c'>1 local line `"`line' & "'
            local line `"`line'`value'"'
            local c=`c'+`width'
        }
        file write `fh' `"`line' \\"' _n
        if `rr'==`hr' file write `fh' "\midrule" _n
        local rr=`rr'+1+`paired'
    }
    quietly mesr_tex_escape, text(`"`note'"')
    local note `"`r(tex)'"'
    file write `fh' "\bottomrule\end{tabular}" _n ///
        `"\par\vspace{3pt}{\fontsize{6.1}{7.5}\selectfont `note'\par}"' _n
    file close `fh'
}

**# Objective 1: selected MNP coefficients, with report reference categories
* Read already formatted Table 5 cells. Never re-estimate or infer stars
* from rounded estimates/SEs. Keep a row if any coefficient has ** or ***.
use `"`input_t5'"', clear
unab vl : _all
local first : word 1 of `vl'
tempname summ
file open `summ' using "$presentation/tables/objective1_summary.tex", write text replace
file write `summ' "\begin{tabularx}{\linewidth}{@{}p{.31\linewidth}YYY@{}}\toprule" _n ///
    "\textbf{Characteristic} & \textbf{FISP only} & \textbf{SAPs only} & \textbf{FISP + SAPs}\\\midrule" _n
local selected=0
forvalues rr=3/`=_N' {
    local label=`first'[`rr']
    if "`label'"=="" | "`label'"=="Constant" continue
    local keep=0
    forvalues j=1/3 {
        local col=2*`j'
        local cv : word `col' of `vl'
        if strpos(`cv'[`rr'],"**") local keep=1
    }
    if !`keep' continue
    local next=`rr'+1
    if `next'>_N {
        file close `summ'
        restore
        di as error "Table 5 coefficient row has no SE row."
        exit 459
    }
    if strpos(lower("`label'"),"age of") local label "Age of head (years)"
    if strpos(lower("`label'"),"household size") local label "Household size"
    if strpos(lower("`label'"),"temperature") local label "Temperature (°C)"
    if strpos(lower("`label'"),"rainfall") local label "Rainfall (mm)"
    if strpos(lower("`label'"),"loam") local label "Soil: loam (base: sandy)"
    if strpos(lower("`label'"),"clay") local label "Soil: clay"
    if strpos(lower("`label'"),"quality: fair") local label "Soil quality: fair (base: good)"
    if strpos(lower("`label'"),"central") local label "Central region (base: North)"
    if strpos(lower("`label'"),"separated") local label "Separated/divorced (base: married)"
    if strpos(lower("`label'"),"widowed") local label "Widowed (base: married)"
    if strpos(lower("`label'"),"never-married") | strpos(lower("`label'"),"never married") local label "Never married (base: married)"
    if strpos(lower("`label'"),"credit") local label "Credit access"
    if strpos(lower("`label'"),"extension advice") local label "Extension advice"
    if strpos(lower("`label'"),"officer") local label "IV: officer >5 km"
    if strpos(lower("`label'"),"radio") local label "IV: radio SAP advice"
    quietly mesr_tex_escape, text(`"`label'"')
    local line `"`r(tex)'"'
    forvalues j=1/3 {
        local col=2*`j'
        local cv : word `col' of `vl'
        local se=`cv'[`next']
        if substr(strtrim("`se'"),1,1)!="(" {
            file close `summ'
            restore
            di as error "Expected SE below Table 5 row `rr'."
            exit 459
        }
        local cell=`cv'[`rr']+" "+`cv'[`next']
        quietly mesr_tex_escape, text(`"`cell'"')
        local line `"`line' & `r(tex)'"'
    }
    file write `summ' `"`line' \\"' _n
    local ++selected
}
assert `selected'>0
local nv : word 2 of `vl'
quietly levelsof `nv' if `first'=="Observations", local(statN) clean
quietly levelsof `nv' if `first'=="Wald χ²", local(statChi) clean
quietly levelsof `nv' if `first'=="Prob > χ²", local(statP) clean
assert "`statN'"!="" & "`statChi'"!="" & "`statP'"!=""
local ptext "`statP'"
if real("`statP'")<.001 local ptext "<0.001"
else local ptext "= `statP'"
file write `summ' "\midrule" _n ///
    "\multicolumn{4}{l}{\textbf{Model:} multinomial probit\quad \textbf{N:} `statN'\quad \textbf{Wald} $\chi^2$: `statChi'\quad \textbf{p}`ptext'}\\" _n ///
    "\bottomrule\end{tabularx}" _n
file close `summ'

**# Figure 1: regime distribution, percentages AND household counts
use `"`input_t1'"', clear
unab vl : _all
local nv : word 4 of `vl'
local sv : word 5 of `vl'
keep in 2/5
gen byte pos=_n
gen double N=real(subinstr(`nv',",","",.))
gen double share=real(subinstr(`sv',"%","",.))
assert !missing(N,share)
egen double totalN=total(N)
replace share=100*N/totalN
gen str40 lab=strtrim(string(share,"%4.1f"))+"% ("+strtrim(string(N,"%9.0fc"))+")"
label define pres_regs 1 "Neither" 2 "FISP only" 3 "SAPs only" 4 "FISP + SAPs", replace
label values pos pres_regs
twoway (bar share pos if pos!=4, horizontal color("38 61 86") barwidth(.55)) ///
       (bar share pos if pos==4, horizontal color("247 148 29") barwidth(.55)) ///
       (scatter pos share, msymbol(none) mlabel(lab) mlabpos(3) mlabcolor("38 61 86")), ///
       ylabel(1/4, valuelabel angle(0)) yscale(reverse) ytitle("") ///
       xlabel(0(10)60) xscale(range(0 63)) xtitle("Share of analysis households (%)") ///
       legend(off) graphregion(color(white)) name(pregimes, replace)
graph export "$presentation/figures/regime_distribution.pdf", replace

**# Figure 2: selected MNP average marginal effects, percentage points
use `"`input_t5'"', clear
unab vl : _all
local vv : word 1 of `vl'
gen byte feature=.
replace feature=1 if strpos(lower(`vv'),"extension") & !strpos(lower(`vv'),"officer")
replace feature=2 if strpos(lower(`vv'),"credit")
replace feature=3 if strpos(lower(`vv'),"shock")
replace feature=4 if strpos(lower(`vv'),"education")
keep if !missing(feature)
isid feature
assert _N==4
forvalues j=1/3 {
    local col=2*`j'+1
    local dv : word `col' of `vl'
    gen double ame`j'=100*real(subinstr(`dv',"−","-",.))
}
keep feature ame1 ame2 ame3
reshape long ame, i(feature) j(regime)
assert !missing(ame)
gen double ypos=feature+(regime-2)*.2
twoway (scatter ypos ame if regime==1, msymbol(S) mcolor(gs8) mlabel(ame) mlabformat(%4.1f)) ///
       (scatter ypos ame if regime==2, msymbol(O) mcolor("38 61 86") mlabel(ame) mlabformat(%4.1f)) ///
       (scatter ypos ame if regime==3, msymbol(D) mcolor("247 148 29") mlabel(ame) mlabformat(%4.1f)), ///
       ylabel(1 "Extension advice" 2 "Credit access" 3 "Drought/flood shock" 4 "Education (one year)", angle(0)) ///
       yscale(reverse) ytitle("") xtitle("Average marginal effect (percentage points)") ///
       xline(0, lcolor(gs10)) legend(order(1 "FISP only" 2 "SAPs only" 3 "FISP + SAPs") rows(1) size(small)) ///
       graphregion(color(white)) name(pames, replace)
graph export "$presentation/figures/objective1_marginal_effects.pdf", replace

**# Figure 3: ATT, ATU and ATE point estimates (no confidence intervals)
* Red vertical line: zero effect relative to neither participation.
* Confidence intervals are omitted for presentation; uncertainty remains in tables.
* Numeric labels retain the significance stars from the SAME table cells.
* Stars are not recomputed from rounded estimates or rounded SEs.
local panels ""
local op=0
foreach nm in eproductivitywinsr eHDDS eFCS {
    local ++op
    use `"`input_`nm''"', clear
    unab vl : _all
    local ev : word 5 of `vl'
    gen double estimate=.
    gen str30 est_label=""
    gen byte regime=.
    gen byte effect=.
    forvalues j=1/3 {
        forvalues k=1/3 {
            local rr=2+4*(`j'-1)+cond(`k'==3,3,`k'-1)
            local cell=subinstr(`ev'[`rr'],"−","-",.)
            replace est_label=word("`cell'",1) in `rr'
            if regexm("`cell'","^ *([-0-9.]+)") replace estimate=real(regexs(1)) in `rr'
            replace regime=`j' in `rr'
            replace effect=`k' in `rr'
        }
    }
    keep if !missing(effect)
    assert !missing(estimate)
    quietly summarize estimate, meanonly
    gen byte largest=(estimate==r(max))
    gen byte significant=(strpos(est_label,"*")>0)
    gen str60 plot_label=est_label
    replace plot_label="{bf:"+est_label+"}" if significant | largest
    gen double ypos=regime+(effect-2)*.17
    quietly summarize estimate, meanonly
    local xmin=min(0,r(min))
    * Current positive estimates start at zero; future negative estimates remain visible.
    quietly summarize estimate, meanonly
    local xmax=max(0,r(max))
    local span=max(`xmax'-`xmin',.01)
    gen double labelx=`xmax'+(.13+.25*(effect-1))*`span'
    local lab1=`xmax'+.13*`span'
    local lab2=`xmax'+.38*`span'
    local lab3=`xmax'+.63*`span'
    local tickstep=`span'/4
    local xmaxlabel=`xmax'+.83*`span'
    if `op'==1 local title "Maize productivity (kg/acre)"
    if `op'==2 local title "Dietary diversity (food groups)"
    if `op'==3 local title "Food Consumption Score (points)"
    * Draw pale row bands and tinted numeric columns behind the points.
    * Two nonmissing coordinates per rectangle; these are display variables.
    gen double shade_y=cond(_n==1,.3,cond(_n==2,3.45,.))
    gen double shade_x=cond(_n==1,`xmin',cond(_n==2,`xmaxlabel',.))
    gen double band_lo1=.68
    gen double band_hi1=1.32
    gen double band_lo3=2.68
    gen double band_hi3=3.32
    forvalues k=1/3 {
        gen double col_lo`k'=`xmax'+(.005+.25*(`k'-1))*`span'
        gen double col_hi`k'=`xmax'+(.255+.25*(`k'-1))*`span'
    }
    * Equal panel geometry: the legend is described once below the panels.
    twoway (rarea band_lo1 band_hi1 shade_x, fcolor("239 243 248") lcolor(none)) ///
           (rarea band_lo3 band_hi3 shade_x, fcolor("239 243 248") lcolor(none)) ///
           (rarea col_lo1 col_hi1 shade_y, horizontal fcolor("230 235 244") lcolor(none)) ///
           (rarea col_lo2 col_hi2 shade_y, horizontal fcolor("255 244 220") lcolor(none)) ///
           (rarea col_lo3 col_hi3 shade_y, horizontal fcolor("227 245 242") lcolor(none)) ///
           (scatter ypos estimate if effect==1, msymbol(O) msize(medium) mfcolor("38 61 86") mlcolor(white) mlwidth(thin)) ///
           (scatter ypos estimate if effect==2, msymbol(S) msize(medium) mfcolor("247 148 29") mlcolor(white) mlwidth(thin)) ///
           (scatter ypos estimate if effect==3, msymbol(D) msize(medium) mfcolor("33 140 141") mlcolor(white) mlwidth(thin)) ///
           (scatter regime labelx if !largest, msymbol(none) mlabel(plot_label) mlabpos(0) mlabsize(small) mlabcolor("38 61 86")) ///
           (scatter regime labelx if largest, msymbol(none) mlabel(plot_label) mlabpos(0) mlabsize(small) mlabcolor("125 36 92")), ///
           ylabel(1 "FISP only" 2 "SAPs only" 3 "FISP + SAPs", angle(0) labsize(small) nogrid) ///
           yscale(reverse range(.3 3.5)) ytitle("") xtitle("") ///
           title("`title'", size(medsmall) pos(11)) xline(0, lcolor(red) lpattern(solid) lwidth(medthick)) ///
           xscale(range(`xmin' `xmaxlabel')) xlabel(`xmin'(`tickstep')`xmax', format(%5.2g) nogrid) ///
           text(.5 `lab1' "ATT" .5 `lab2' "ATU" .5 `lab3' "ATE", size(small)) ///
           legend(off) graphregion(color(white)) name(pe`op', replace)
    local panels `panels' pe`op'
}
graph combine `panels', cols(1) xsize(12) ysize(7.2) iscale(1) graphregion(color(white)) note("ATT: navy circles   |   ATU: amber squares   |   ATE: teal diamonds", size(vsmall)) name(pall, replace)
graph export "$presentation/figures/att_atu_ate_summary.pdf", replace
* Other figures already generated by the main run can be uploaded too.
copy "$result/Fig2_outcomes_10_15.png" "$presentation/figures/Fig2_outcomes_10_15.png", replace
copy "$result/Fig2_outcomes_10_15.png" "$presentation/figures/outcome_distributions.png", replace
copy "$result/Fig3_overlap_10_15.png" "$presentation/figures/overlap.png", replace
**# Dynamic sample totals used in slide text
use `"`input_t1'"', clear
unab vv : _all
local nv : word 4 of `vv'
local sv : word 5 of `vv'
local total=real(subinstr(`nv'[_N],",","",.))
local ntext=strtrim(string(`total',"%12.0fc"))
local both=real(subinstr(`sv'[5],"%","",.))
local btext=strtrim(string(`both',"%4.1f"))
use `"`input_ta2'"', clear
unab vv : _all
local val : word 2 of `vv'
local counts=subinstr(`val'[3],"/"," ",.)
local ne : word 1 of `counts'
local nd : word 2 of `counts'
tempname sc
file open `sc' using "$presentation/tables/scalars.tex", write text replace
file write `sc' "\def\SampleN{`ntext'}" _n ///
    "\def\SampleEA{`ne'}" _n "\def\SampleDistricts{`nd'}" _n ///
    "\def\JointShare{`btext'}" _n
file close `sc'

foreach nm of local exportnames {
    if "`nm'"!="ta2" confirm file "$presentation/tables/`nm'.tex"
}
confirm file "$presentation/tables/objective1_summary.tex"
foreach fig in regime_distribution.pdf att_atu_ate_summary.pdf Fig2_outcomes_10_15.png overlap.png {
    confirm file "$presentation/figures/`fig'"
}
file open `manifest' using "$presentation/tables/export_status.txt", write text replace
file write `manifest' "COMPLETE" _n "Stata export: `c(current_date)' `c(current_time)'" _n
file close `manifest'
restore
di as result "Updated tables/ and figures/ under $presentation. Upload these folders to Overleaf."
